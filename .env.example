# BoringBros Real Email Authentication Configuration
#
# 1. Sign up for free at https://resend.com (Takes 1-2 minutes)
# 2. Go to "API Keys" -> Click "Create API Key" (Permission: Full Access)
# 3. Paste the key below:

RESEND_API_KEY=re_your_api_key_here

# Sending Email Address:
# - During development/testing, Resend allows you to send from: BoringBros <onboarding@resend.dev>
#   (Note: in free test mode, onboarding@resend.dev sends to the email you signed up with on Resend)
# - For production with your own domain (e.g. boringbrolabs.com):
#   Verify your domain in Resend DNS settings, then set:
#   EMAIL_FROM=BoringBros <auth@yourdomain.com>

EMAIL_FROM=BoringBros <onboarding@resend.dev>
